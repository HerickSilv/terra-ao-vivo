{
  "name": "terra-ao-vivo",
  "private": true,
  "version": "1.0.0",
  "description": "Globo 3D com terremotos, eventos naturais e focos de queimadas em tempo quase real.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "etl": "uv run --directory etl python -m terra_etl --out ../public/data/focos.json",
    "etl:test": "uv run --directory etl pytest",
    "etl:lint": "uv run --directory etl ruff check ."
  },
  "dependencies": {
    "@fontsource-variable/sofia-sans-extra-condensed": "^5.3.0",
    "@fontsource/alegreya-sans": "^5.3.0",
    "globe.gl": "^2.46.2",
    "i18n-iso-countries": "^7.14.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
